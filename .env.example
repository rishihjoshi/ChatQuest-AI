# ChatQuest-AI — environment variables
#
# Copy to .env.local for local development with `vercel dev`.
# NEVER commit a file containing a real key — .env* is gitignored.
#
# In production these are set in the Vercel dashboard:
#   Project → Settings → Environment Variables
# They are read server-side only, inside api/chat.js. Nothing here is ever
# exposed to the browser (do not prefix anything with NEXT_PUBLIC_ or similar).

# Required. Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Comma-separated extra origins allowed to call /api/chat, on top of
# the deployment's own domain and localhost. Set this if you serve the app from
# a custom domain that differs from the request Host header, e.g.:
#   ALLOWED_ORIGINS=https://chatquest.example.com,https://www.chatquest.example.com
ALLOWED_ORIGINS=
